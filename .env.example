DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_SERVER_IP
DJANGO_SETTINGS_MODULE=debt_project.settings

# Comma-separated IPs allowed to WRITE via the token-free
# /api/v1/criteria/internal/* endpoints (GET is always open).
# Must include the address the case-assessment backend connects FROM —
# calling the server by its LAN IP shows up as that LAN IP, not 127.0.0.1.
INTERNAL_API_ALLOWED_IPS=127.0.0.1,::1,localhost,YOUR_SERVER_IP

# Reverse proxies whose X-Forwarded-For header may be trusted when resolving
# the caller IP above. Leave empty unless a proxy fronts this service.
INTERNAL_API_TRUSTED_PROXIES=

# Path to the tesseract binary (OCR for council-tax evidence image uploads).
# Leave blank on Linux once the tesseract-ocr package is installed (it's
# found on PATH automatically). On Windows, install via
# `winget install UB-Mannheim.TesseractOCR` and point this at the exe.
TESSERACT_CMD=

# --- Live server behind the HTTPS domain (leave unset on a plain-HTTP server) ---
# Set APP_CODE_VERSION to the deployed git commit / tag.
# APP_CODE_VERSION=
# CSRF_TRUSTED_ORIGINS=https://your-live-domain.appform.co.uk
# BEHIND_HTTPS_PROXY=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
