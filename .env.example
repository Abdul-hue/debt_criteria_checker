DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_SERVER_IP
DJANGO_SETTINGS_MODULE=debt_project.settings

# Comma-separated IPs allowed to WRITE via the token-free
# /api/v1/criteria/internal/* endpoints (GET is always open).
# Must include the address the case-assessment backend connects FROM —
# calling the server by its LAN IP shows up as that LAN IP, not 127.0.0.1.
INTERNAL_API_ALLOWED_IPS=127.0.0.1,::1,localhost,YOUR_SERVER_IP

# Reverse proxies whose X-Forwarded-For header may be trusted when resolving
# the caller IP above. Leave empty unless a proxy fronts this service.
INTERNAL_API_TRUSTED_PROXIES=

# --- Aryza (read-only MySQL replica) -----------------------------------------
ARYZA_DB_HOST=
ARYZA_DB_USER=
ARYZA_DB_PASSWORD=
ARYZA_DB_NAME=
ARYZA_DB_PORT=3306

# Shared secret for internal service-to-service calls from case assessment.
# Must match the key configured in the main project.
DEBT_CRITERIA_INTERNAL_KEY=

# --- Email / MOC alerts -------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
MOC_ALERT_RECIPIENTS=
MOC_ALERT_FROM_EMAIL=

# --- Diagnostics --------------------------------------------------------------
# Prints every request and response status to stdout. Off by default: it floods
# test output and production logs.
REQUEST_DEBUG_MIDDLEWARE=False
# Where runtime log files are written. Defaults to <repo>/logs.
LOG_DIR=
